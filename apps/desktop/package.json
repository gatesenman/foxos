{
  "name": "foxos-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "狐狸OS（FoxOS）桌面",
  "main": "src/main/index.js",
  "author": "gaosichun",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux dir",
    "dist:linux:appimage": "electron-builder --linux AppImage",
    "dist:win": "npm run prepare:win-pty && npm run prepare:win-python && electron-builder --win --x64",
    "test:smoke": "bash scripts/smoke.sh",
    "prepare:win-python": "bash scripts/prepare-win-python.sh",
    "prepare:win-pty": "npm install --no-save --force @lydell/node-pty-win32-x64@1.2.0-beta.18",
    "lint:i18n": "node scripts/lint-i18n.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "playwright": "^1.65.0"
  },
  "homepage": "https://github.com/gatesenman/foxos",
  "build": {
    "appId": "io.github.gatesenman.foxos",
    "productName": "FoxOS",
    "copyright": "Copyright © 2026 gaosichun",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/node_modules/@lydell/node-pty-linux-*/**"
    ],
    "extraResources": [
      {
        "from": "../../packages/core/foxos",
        "to": "core/foxos",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../../assets/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../../assets/icon.ico",
      "executableName": "FoxOS",
      "signExecutable": false,
      "artifactName": "FoxOS-${version}-win-x64.${ext}",
      "extraResources": [
        {
          "from": "../../build/win-python",
          "to": "python",
          "filter": [
            "**/*"
          ]
        }
      ],
      "files": [
        "!**/node_modules/@lydell/node-pty-linux-*/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "狐狸OS",
      "installerIcon": "../../assets/icon.ico",
      "uninstallerIcon": "../../assets/icon.ico",
      "artifactName": "FoxOS-Setup-${version}-x64.${ext}"
    },
    "linux": {
      "target": [
        "dir",
        "AppImage"
      ],
      "icon": "../../assets/icon.png",
      "category": "Office",
      "executableName": "foxos-desktop",
      "maintainer": "gaosichun",
      "files": [
        "!**/node_modules/@lydell/node-pty-win32-*/**"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "../../assets/icon.png",
      "category": "public.app-category.productivity"
    },
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/@lydell/**"
    ]
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@tabler/icons-webfont": "^3.51.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.57.0"
  }
}
