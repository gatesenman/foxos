{
  "name": "foxos-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "狐狸OS（FoxOS）桌面",
  "main": "src/main/index.js",
  "author": "gaosichun",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux dir",
    "dist:linux:appimage": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win nsis",
    "test:smoke": "bash scripts/smoke.sh"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "playwright": "^1.65.0"
  },
  "homepage": "https://github.com/gatesenman/foxos",
  "build": {
    "appId": "io.github.gatesenman.foxos",
    "productName": "FoxOS",
    "copyright": "Copyright © 2026 gaosichun",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../packages/core/foxos",
        "to": "core/foxos",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "../../assets/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../../assets/icon.ico",
      "executableName": "FoxOS"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "狐狸OS",
      "installerIcon": "../../assets/icon.ico",
      "uninstallerIcon": "../../assets/icon.ico",
      "artifactName": "FoxOS-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "dir",
        "AppImage"
      ],
      "icon": "../../assets/icon.png",
      "category": "Office",
      "executableName": "foxos-desktop",
      "maintainer": "gaosichun"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "../../assets/icon.png",
      "category": "public.app-category.productivity"
    }
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@tabler/icons-webfont": "^3.51.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.57.0"
  }
}
