{
  "name": "foxos-desktop",
  "version": "0.3.4",
  "private": true,
  "description": "狐狸OS（FoxOS）桌面",
  "main": "src/main/index.js",
  "author": "gaosichun",
  "scripts": {
    "start": "electron .",
    "prepare:platform": "bash ../../scripts/packaging/prepare-platform.sh",
    "dist:linux": "bash ../../scripts/packaging/prepare-platform.sh linux x64 && electron-builder --linux --x64 --publish never",
    "dist:linux:arm64": "bash ../../scripts/packaging/prepare-platform.sh linux arm64 && electron-builder --linux --arm64 --publish never",
    "dist:mac": "bash ../../scripts/packaging/prepare-platform.sh mac arm64 && electron-builder --mac --arm64 --publish never",
    "dist:mac:x64": "bash ../../scripts/packaging/prepare-platform.sh mac x64 && electron-builder --mac --x64 --publish never",
    "dist:win": "bash ../../scripts/packaging/prepare-platform.sh win x64 && electron-builder --win --x64 --publish never",
    "dist:win:arm64": "bash ../../scripts/packaging/prepare-platform.sh win arm64 && electron-builder --win --arm64 --publish never",
    "test:smoke": "bash scripts/smoke.sh",
    "lint:i18n": "node scripts/lint-i18n.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "playwright": "^1.65.0"
  },
  "homepage": "https://github.com/gatesenman/foxos",
  "build": {
    "appId": "io.github.gatesenman.foxos",
    "productName": "FoxOS",
    "copyright": "Copyright © 2026 gaosichun",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../packages/core/foxos",
        "to": "core/foxos",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../../assets/icon.png",
        "to": "icon.png"
      },
      {
        "from": "../../build/python",
        "to": "python",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip",
        "msi"
      ],
      "icon": "../../assets/icon.ico",
      "executableName": "FoxOS",
      "signExecutable": false,
      "artifactName": "FoxOS-${version}-win-${arch}.${ext}",
      "extraResources": [
        {
          "from": "build-resources/bin",
          "to": "bin",
          "filter": [
            "foxos.cmd"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "狐狸OS",
      "installerIcon": "../../assets/icon.ico",
      "uninstallerIcon": "../../assets/icon.ico",
      "artifactName": "FoxOS-Setup-${version}-${arch}.${ext}",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "displayLanguageSelector": false,
      "include": "build-resources/win/installer.nsh"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "tar.gz"
      ],
      "icon": "../../assets/icon.png",
      "category": "Office",
      "executableName": "foxos-desktop",
      "maintainer": "gaosichun",
      "artifactName": "FoxOS-${version}-linux-${arch}.${ext}",
      "synopsis": "狐狸OS（FoxOS）桌面与 foxos 命令行",
      "description": "狐狸OS 桌面伴侣程序与 foxos 命令行（自带 Python 3.12 与内核）。FoxOS desktop companion and foxos CLI.",
      "extraResources": [
        {
          "from": "build-resources/bin",
          "to": "bin",
          "filter": [
            "**/*",
            "!*.cmd"
          ]
        }
      ],
      "desktop": {
        "entry": {
          "Name": "FoxOS",
          "Name[zh_CN]": "狐狸OS",
          "Comment": "FoxOS desktop",
          "Comment[zh_CN]": "狐狸OS 桌面",
          "Keywords": "foxos;agent;"
        }
      }
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "../../assets/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "FoxOS-${version}-mac-${arch}.${ext}",
      "extraResources": [
        {
          "from": "build-resources/bin",
          "to": "bin",
          "filter": [
            "**/*",
            "!*.cmd"
          ]
        }
      ],
      "hardenedRuntime": true,
      "entitlements": "build-resources/mac/entitlements.plist",
      "entitlementsInherit": "build-resources/mac/entitlements.plist",
      "minimumSystemVersion": "11.0"
    },
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/@lydell/**"
    ],
    "msi": {
      "artifactName": "FoxOS-${version}-win-${arch}.${ext}",
      "perMachine": true,
      "oneClick": false,
      "upgradeCode": "6f3d2c9e-5b1a-4e8f-9a47-2c0b7d1e4f58",
      "shortcutName": "FoxOS",
      "runAfterFinish": false
    },
    "deb": {
      "afterInstall": "build-resources/linux/after-install.sh",
      "afterRemove": "build-resources/linux/after-remove.sh",
      "priority": "optional",
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "libgbm1",
        "libdrm2"
      ],
      "recommends": [
        "fonts-noto-cjk"
      ]
    },
    "rpm": {
      "afterInstall": "build-resources/linux/after-install.sh",
      "afterRemove": "build-resources/linux/after-remove.sh",
      "fpm": [
        "--rpm-rpmbuild-define=_build_id_links none"
      ],
      "depends": [
        "(gtk3 or libgtk-3-0)",
        "(libnotify or libnotify4)",
        "(nss or mozilla-nss)",
        "(libXScrnSaver or libXss1)",
        "(libXtst or libXtst6)",
        "xdg-utils",
        "at-spi2-core",
        "(libuuid or libuuid1)",
        "(alsa-lib or libasound2)",
        "(mesa-libgbm or libgbm1)",
        "(liberation-fonts or dejavu-sans-fonts or google-noto-sans-fonts)"
      ]
    },
    "dmg": {
      "title": "FoxOS ${version}",
      "artifactName": "FoxOS-${version}-mac-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "gatesenman",
      "repo": "foxos",
      "releaseType": "prerelease"
    }
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@tabler/icons-webfont": "^3.51.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.57.0"
  }
}
