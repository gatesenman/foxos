#!/usr/bin/python3
"""狐狸OS 桌面底部面板：开始菜单、时钟、会话、人工接管。GTK 3，不是假桌面。"""
import gi, os, sys, signal, subprocess, glob, threading
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib, GdkPixbuf

CSS = """
window.foxos-panel { background: #11141b; color: #e6e8ee; border-top: 1px solid #262c3a; }
button { background: transparent; color: #e6e8ee; border: 0; border-radius: 6px; padding: 2px 10px; font: 13px "Noto Sans CJK SC", sans-serif; }
button:hover { background: #1f2430; }
button.primary { background: #ff8a3d; color: #1a0f05; font-weight: 600; }
button.primary:hover { background: #ffb27a; }
button.warn { background: #3a2e12; color: #f5b84a; }
button.warn.on { background: #f5b84a; color: #1a0f05; }
#clock { padding: 0 12px; color: #a9afbe; }
#brand { font-weight: 600; padding-left: 4px; }
popover { background: #11141b; border: 1px solid #262c3a; }
.pop-item { padding: 6px 14px; }
.pop-item:hover { background: #1f2430; }
.section { color: #6f7789; padding: 8px 14px 2px; font-size: 11px; }
"""

SOCK = os.environ.get("XDG_RUNTIME_DIR", "/tmp") + "/foxos-panel.pid"
TOGGLE = "--toggle-menu" in sys.argv

def run(*cmd, timeout=3):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except Exception:
        return None

# foxos control 若在 GTK 主线程同步调用，会堵住 show/绘制（Live 下 MCP 未就绪时尤其明显）。
_pause_state = False
_pause_inflight = False

def _refresh_paused():
    global _pause_state, _pause_inflight
    val = False
    p = run("foxos", "control", "status", "--json", timeout=2)
    if p and p.returncode == 0:
        try:
            import json
            d = json.loads(p.stdout)
            val = bool(d.get("paused") or (d.get("result") or d.get("data") or {}).get("paused"))
        except Exception:
            val = "paused" in (p.stdout or "").lower() and "true" in (p.stdout or "").lower()
    _pause_state = val
    _pause_inflight = False

def paused():
    global _pause_inflight
    if not _pause_inflight:
        _pause_inflight = True
        threading.Thread(target=_refresh_paused, daemon=True).start()
    return _pause_state

def desktop_files():
    seen, out = set(), []
    dirs = ["/usr/share/applications", os.path.expanduser("~/.local/share/applications")]
    for d in dirs:
        for f in sorted(glob.glob(d + "/*.desktop")):
            info = {}
            try:
                text = open(f, encoding="utf-8").read().splitlines()
            except Exception:
                continue
            in_entry = False
            for line in text:
                if line.strip() == "[Desktop Entry]":
                    in_entry = True
                    continue
                if line.startswith("[") and in_entry:
                    break
                if in_entry and "=" in line:
                    k, v = line.split("=", 1)
                    info[k] = v
            if info.get("NoDisplay") == "true" or info.get("Type") != "Application":
                continue
            if info.get("Hidden") == "true" or "OnlyShowIn" in info and "FoxOS" not in info["OnlyShowIn"] and "labwc" not in info["OnlyShowIn"]:
                continue
            name = info.get("Name[zh_CN]") or info.get("Name[zh]") or info.get("Name")
            exec_cmd = info.get("Exec")
            if not name or not exec_cmd:
                continue
            exec_cmd = exec_cmd.split("%")[0].strip()
            if exec_cmd in seen:
                continue
            seen.add(exec_cmd)
            out.append((name, exec_cmd, info.get("Categories", "")))
    out.sort(key=lambda x: x[0].lower())
    return out


def attach_layer_shell(win, height=40):
    """在 labwc（Wayland）上把面板贴到底边并预留空间。GTK3 的 DOCK 提示不够。"""
    try:
        gi.require_version("GtkLayerShell", "0.1")
        from gi.repository import GtkLayerShell
    except Exception as e:
        print("foxos-panel: 没有 GtkLayerShell（%s）" % e, file=sys.stderr)
        return False
    try:
        if hasattr(GtkLayerShell, "is_supported") and not GtkLayerShell.is_supported():
            print("foxos-panel: 合成器不支持 zwlr-layer-shell", file=sys.stderr)
            return False
    except Exception:
        pass
    GtkLayerShell.init_for_window(win)
    GtkLayerShell.set_layer(win, GtkLayerShell.Layer.TOP)
    GtkLayerShell.set_anchor(win, GtkLayerShell.Edge.LEFT, True)
    GtkLayerShell.set_anchor(win, GtkLayerShell.Edge.RIGHT, True)
    GtkLayerShell.set_anchor(win, GtkLayerShell.Edge.BOTTOM, True)
    GtkLayerShell.set_exclusive_zone(win, height)
    try:
        GtkLayerShell.set_keyboard_mode(win, GtkLayerShell.KeyboardMode.ON_DEMAND)
    except Exception:
        try:
            GtkLayerShell.set_keyboard_interactivity(win, True)
        except Exception:
            pass
    try:
        GtkLayerShell.set_namespace(win, "foxos-panel")
    except Exception:
        pass
    print("foxos-panel: layer-shell ok", flush=True)
    return True


class Panel(Gtk.Window):
    def __init__(self):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_name("foxos-panel")
        self.get_style_context().add_class("foxos-panel")
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_app_paintable(True)
        self.layer = attach_layer_shell(self, 40)
        if not self.layer:
            # 无 layer-shell 时退回 X11 dock 提示（Wayland 上通常贴不了底）
            self.set_type_hint(Gdk.WindowTypeHint.DOCK)
            self.set_accept_focus(False)
        self.menu = None
        self.paused = False
        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        bar.set_margin_start(6); bar.set_margin_end(6)
        self.add(bar)
        start = Gtk.Button()
        start.get_style_context().add_class("primary")
        hb = Gtk.Box(spacing=6)
        icon = "/usr/share/pixmaps/foxos.png"
        if os.path.exists(icon):
            try:
                pix = GdkPixbuf.Pixbuf.new_from_file_at_size(icon, 20, 20)
                hb.pack_start(Gtk.Image.new_from_pixbuf(pix), False, False, 0)
            except Exception:
                pass
        lab = Gtk.Label(label="开始"); lab.set_name("brand")
        hb.pack_start(lab, False, False, 0)
        start.add(hb)
        start.connect("clicked", self.toggle_menu)
        bar.pack_start(start, False, False, 0)
        self.status = Gtk.Label(label="")
        self.status.set_xalign(0)
        bar.pack_start(self.status, True, True, 8)
        self.take = Gtk.Button(label="人工接管")
        self.take.get_style_context().add_class("warn")
        self.take.connect("clicked", self.on_takeover)
        bar.pack_end(self.take, False, False, 0)
        power = Gtk.Button(label="系统")
        power.connect("clicked", self.on_power)
        bar.pack_end(power, False, False, 0)
        self.clock = Gtk.Label(label="")
        self.clock.set_name("clock")
        bar.pack_end(self.clock, False, False, 0)
        if self.layer:
            # 必须在 show 之前给出高度，否则 labwc 上 layer 表面可能是 0 高，看不见面板。
            self.set_size_request(-1, 40)
            bar.set_size_request(-1, 40)
        self.connect("realize", self.place)
        self.connect("destroy", Gtk.main_quit)
        GLib.timeout_add(200, self.tick)
        # 不要在 __init__ 里同步 tick()：foxos control 可能卡住，show_all 之前窗口不会出现。

    def screen_box(self):
        geo = self.get_screen().get_monitor_geometry(self.get_screen().get_primary_monitor())
        return geo

    def place(self, *_):
        h = 40
        if getattr(self, "layer", False):
            self.set_size_request(-1, h)
            return
        geo = self.screen_box()
        self.set_size_request(geo.width, h)
        self.resize(geo.width, h)
        self.move(geo.x, geo.y + geo.height - h)
        try:
            self.get_window().set_override_redirect(False)
        except Exception:
            pass
        self.set_strut()

    def set_strut(self):
        try:
            from gi.repository import GdkX11  # noqa: F401
        except Exception:
            return
        # Wayland 下 strut 无效；labwc 可用 window rules 预留。先把面板放底部。

    def tick(self):
        import time
        self.clock.set_text(time.strftime("%Y-%m-%d  %H:%M"))
        self.paused = paused()
        self.take.set_label("接管中 · 点击恢复" if self.paused else "人工接管")
        if self.paused:
            self.take.get_style_context().add_class("on")
            self.status.set_text("智能体写操作已暂停")
        else:
            self.take.get_style_context().remove_class("on")
            if not self.status.get_text() or self.status.get_text().startswith("智能体"):
                self.status.set_text("")
        return True

    def close_menu(self, *_):
        if self.menu:
            try:
                self.menu.destroy()
            except Exception:
                pass
            self.menu = None

    def popup_layer(self, width=280, height=-1):
        """在 Wayland 上 Gtk.Popover 贴不到 layer-shell 面板；用 overlay 窗口代替。"""
        win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        win.set_decorated(False)
        win.set_skip_taskbar_hint(True)
        win.set_skip_pager_hint(True)
        win.get_style_context().add_class("foxos-panel")
        if width:
            win.set_size_request(width, height if height > 0 else -1)
        if getattr(self, "layer", False):
            try:
                gi.require_version("GtkLayerShell", "0.1")
                from gi.repository import GtkLayerShell
                GtkLayerShell.init_for_window(win)
                GtkLayerShell.set_layer(win, GtkLayerShell.Layer.OVERLAY)
                GtkLayerShell.set_anchor(win, GtkLayerShell.Edge.BOTTOM, True)
                GtkLayerShell.set_anchor(win, GtkLayerShell.Edge.LEFT, True)
                GtkLayerShell.set_margin(win, GtkLayerShell.Edge.BOTTOM, 44)
                GtkLayerShell.set_margin(win, GtkLayerShell.Edge.LEFT, 6)
                try:
                    GtkLayerShell.set_keyboard_mode(win, GtkLayerShell.KeyboardMode.ON_DEMAND)
                except Exception:
                    pass
            except Exception:
                pass
        return win

    def toggle_menu(self, *_):
        if self.menu and self.menu.get_visible():
            self.close_menu(); return
        self.close_menu()
        pop = self.popup_layer(280, 420)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        box.set_size_request(280, -1)
        title = Gtk.Label(label="应用程序"); title.get_style_context().add_class("section"); title.set_xalign(0)
        box.pack_start(title, False, False, 0)
        pinned = [("终端", "gnome-terminal"), ("文件", "thunar"), ("浏览器", "firefox"),
                  ("编辑器", "gnome-text-editor"), ("安装 狐狸OS", "pkexec calamares")]
        for name, cmd in pinned:
            b = Gtk.Button(label=name, relief=Gtk.ReliefStyle.NONE)
            b.get_style_context().add_class("pop-item"); b.set_halign(Gtk.Align.START)
            b.connect("clicked", lambda _w, c=cmd: (subprocess.Popen(c, shell=True), self.close_menu()))
            box.pack_start(b, False, False, 0)
        more = Gtk.Label(label="全部"); more.get_style_context().add_class("section"); more.set_xalign(0)
        box.pack_start(more, False, False, 0)
        scroll = Gtk.ScrolledWindow(); scroll.set_min_content_height(240); scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        for name, cmd, _cat in desktop_files()[:80]:
            b = Gtk.Button(label=name, relief=Gtk.ReliefStyle.NONE)
            b.get_style_context().add_class("pop-item"); b.set_halign(Gtk.Align.START)
            b.connect("clicked", lambda _w, c=cmd: (subprocess.Popen(c, shell=True), self.close_menu()))
            inner.pack_start(b, False, False, 0)
        scroll.add(inner)
        box.pack_start(scroll, True, True, 0)
        pop.add(box)
        pop.show_all()
        self.menu = pop

    def on_takeover(self, *_):
        if self.paused:
            run("foxos", "control", "resume")
        else:
            run("foxos", "control", "pause", "--reason", "面板按钮")
        self.tick()

    def on_power(self, btn):
        if self.menu and self.menu.get_visible():
            self.close_menu(); return
        self.close_menu()
        pop = self.popup_layer(200, -1)
        if getattr(self, "layer", False):
            try:
                from gi.repository import GtkLayerShell
                GtkLayerShell.set_anchor(pop, GtkLayerShell.Edge.LEFT, False)
                GtkLayerShell.set_anchor(pop, GtkLayerShell.Edge.RIGHT, True)
                GtkLayerShell.set_margin(pop, GtkLayerShell.Edge.RIGHT, 6)
            except Exception:
                pass
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        actions = [("退出会话", ["labwc", "--exit"]),
                   ("锁定", ["loginctl", "lock-session"]),
                   ("关机", ["systemctl", "poweroff"]),
                   ("重新启动", ["systemctl", "reboot"])]
        for name, cmd in actions:
            b = Gtk.Button(label=name, relief=Gtk.ReliefStyle.NONE)
            b.get_style_context().add_class("pop-item"); b.set_halign(Gtk.Align.START)
            b.connect("clicked", lambda _w, c=cmd: (subprocess.Popen(c), self.close_menu()))
            box.pack_start(b, False, False, 0)
        pop.add(box)
        pop.show_all()
        self.menu = pop


def css():
    p = Gtk.CssProvider()
    try:
        p.load_from_data(CSS.encode())
    except Exception as e:
        print("foxos-panel css:", e, file=sys.stderr)
        return
    screen = Gdk.Screen.get_default()
    if screen is None:
        return
    Gtk.StyleContext.add_provider_for_screen(screen, p, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

def main():
    if TOGGLE:
        if os.path.exists(SOCK):
            try:
                os.kill(int(open(SOCK).read().strip()), signal.SIGUSR1)
                return
            except Exception:
                pass
        # 面板还没起来就直接退出，避免再开一个
        return
    css()
    win = Panel()
    def on_usr1(*_):
        GLib.idle_add(win.toggle_menu)
        return True
    # Gtk.main() 不会可靠地投递 Python 的 signal.signal；用 GLib 的 unix 信号源。
    if hasattr(GLib, "unix_signal_add"):
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, on_usr1)
    else:
        signal.signal(signal.SIGUSR1, on_usr1)
    open(SOCK, "w").write(str(os.getpid()))
    win.show_all()
    try:
        Gtk.main()
    finally:
        try: os.remove(SOCK)
        except Exception: pass

if __name__ == "__main__":
    main()
