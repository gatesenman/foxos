#!/bin/sh
# xfce4-genmon-plugin：显示「人工接管」或「接管中」，点击切换。
set -eu
# 直接看接管标记文件（foxos control pause 写的就是它），不起 Python：
# genmon 在面板线程里同步执行命令，慢命令会让指示器一直停在旧状态。
paused=0
ws=${FOXOS_WORKSPACE:-$HOME/FoxOS/workspace}
[ -e "$ws/.foxos/paused" ] && paused=1
if [ "$paused" = 1 ]; then
  printf '<icon>media-playback-start-symbolic</icon>\n'
  printf '<iconclick>/usr/lib/foxos/panel/foxos-takeover resume</iconclick>\n'
  printf '<txt> <span fgcolor="#F5B84A" weight="bold">接管中</span></txt>\n'
  printf '<txtclick>/usr/lib/foxos/panel/foxos-takeover resume</txtclick>\n'
  printf '<tool>人工接管中：智能体写操作已暂停。点击恢复。</tool>\n'
else
  printf '<icon>media-playback-pause-symbolic</icon>\n'
  printf '<iconclick>/usr/lib/foxos/panel/foxos-takeover pause</iconclick>\n'
  printf '<txt> 人工接管</txt>\n'
  printf '<txtclick>/usr/lib/foxos/panel/foxos-takeover pause</txtclick>\n'
  printf '<tool>暂停智能体的写操作，由你接管桌面。</tool>\n'
fi
