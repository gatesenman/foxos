#!/bin/sh
# Live 桌面登录后显示 SSH 地址与一次性密码（来自 /run/foxos/live-ssh.txt）。
for i in $(seq 60); do [ -r /run/foxos/live-ssh.txt ] && break; sleep 2; done
[ -r /run/foxos/live-ssh.txt ] || exit 0
cp /run/foxos/live-ssh.txt "$HOME/Desktop/SSH-远程登录.txt" 2>/dev/null || true
command -v zenity >/dev/null && zenity --warning --title "SSH 远程登录（Live）" --width 560 --no-wrap --text "$(cat /run/foxos/live-ssh.txt)" >/dev/null 2>&1 &
exit 0
