#!/bin/sh
# 仅当内核参数带 foxos.vnc 时开放 VNC（Docker 试用镜像、远程排错）。默认安装不监听。
set -eu
if [ -r /proc/cmdline ] && grep -qw foxos.vnc /proc/cmdline && command -v x11vnc >/dev/null; then
  exec x11vnc -display "${DISPLAY:-:0}" -forever -shared -rfbport 5900 -nopw -listen 0.0.0.0 \
    -o /tmp/foxos-x11vnc.log >/tmp/foxos-x11vnc.out 2>&1
fi
exit 0
