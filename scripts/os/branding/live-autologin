#!/bin/sh
# Live 介质（存在 /cdrom/casper 或 /run/live）时让 lightdm 自动登录 foxos 用户；安装后的磁盘没有这些路径。
set -eu
CONF=/etc/lightdm/lightdm.conf.d/10-live.conf
if [ -d /cdrom/casper ] || [ -d /run/live ] || [ -d /run/casper ]; then
  mkdir -p /etc/lightdm/lightdm.conf.d
  # 若 casper 的 adduser 因 /run 缺失等原因失败，这里补建 Live 用户，
  # 并写入 AccountsService，避免 lightdm 报 “Can't login unknown user 'foxos'”。
  if ! getent passwd foxos >/dev/null 2>&1; then
    mkdir -p /run /home
    adduser --disabled-password --gecos "狐狸OS" --uid 1000 foxos 2>/dev/null \
      || useradd -m -u 1000 -c "狐狸OS" -s /bin/bash foxos || true
    usermod -aG sudo,adm,cdrom,dip,plugdev,users foxos 2>/dev/null || true
    echo "foxos ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/casper
    chmod 440 /etc/sudoers.d/casper
  fi
  passwd -d foxos 2>/dev/null || true
  mkdir -p /var/lib/AccountsService/users /home/foxos
  chown -R foxos:foxos /home/foxos 2>/dev/null || true
  cat > /var/lib/AccountsService/users/foxos <<'U'
[User]
SystemAccount=false
Session=foxos
XSession=foxos
Language=zh_CN.UTF-8
U
  cat > "$CONF" <<'U'
[Seat:*]
autologin-user=foxos
autologin-user-timeout=0
user-session=foxos
U
else
  rm -f "$CONF"
fi
exit 0
