<?xml version="1.0"?>
<labwc_config>
  <core>
    <gap>4</gap>
    <decorativeWindowTitle>yes</decorativeWindowTitle>
  </core>
  <theme>
    <name>FoxOS</name>
    <cornerRadius>6</cornerRadius>
    <dropShadows>yes</dropShadows>
  </theme>
  <desktops number="4">
    <popupTime>400</popupTime>
  </desktops>
  <focus>
    <followMouse>no</followMouse>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>
  <keyboard>
    <default />
    <keybind key="A-Tab"><action name="NextWindow" /></keybind>
    <keybind key="A-S-Tab"><action name="PreviousWindow" /></keybind>
    <keybind key="A-F4"><action name="Close" /></keybind>
    <keybind key="W-Return"><action name="Execute" command="gnome-terminal" /></keybind>
    <keybind key="W-e"><action name="Execute" command="thunar" /></keybind>
    <keybind key="W-space"><action name="Execute" command="/usr/lib/foxos/panel/foxos-panel --toggle-menu" /></keybind>
    <keybind key="Super_L" onRelease="yes"><action name="Execute" command="/usr/lib/foxos/panel/foxos-panel --toggle-menu" /></keybind>
    <keybind key="A-Escape"><action name="Execute" command="foxos control pause --reason 键盘快捷键" /></keybind>
    <keybind key="W-1"><action name="GoToDesktop" to="1" /></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2" /></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3" /></keybind>
    <keybind key="W-4"><action name="GoToDesktop" to="4" /></keybind>
    <keybind key="Print"><action name="Execute" command="grim ~/Pictures/foxos-$(date +%Y%m%d-%H%M%S).png" /></keybind>
  </keyboard>
  <mouse>
    <default />
  </mouse>
  <windowSwitcher>
    <preview>no</preview>
    <outlines>yes</outlines>
  </windowSwitcher>
  <snapping>
    <range>8</range>
  </snapping>
</labwc_config>
