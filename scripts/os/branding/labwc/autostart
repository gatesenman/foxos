#!/bin/sh
# 狐狸OS 会话启动：壁纸、面板、输入法、网络小程序、用户级 MCP
swaybg -i /usr/share/backgrounds/foxos/default.png -m fill >/tmp/foxos-swaybg.log 2>&1 &
/usr/lib/foxos/panel/foxos-panel >/tmp/foxos-panel.log 2>&1 &
fcitx5 -d >/tmp/foxos-fcitx.log 2>&1 || true
# nm-applet 需要 AppIndicator / XWayland，没有也不影响有线网络（NetworkManager 在后台跑）
command -v nm-applet >/dev/null && nm-applet >/tmp/foxos-nm.log 2>&1 &
xdg-user-dirs-update || true
mkdir -p "$HOME/FoxOS/workspace"
# 用户级 MCP（安装了 systemd --user 时）
if command -v systemctl >/dev/null; then
  systemctl --user import-environment DISPLAY WAYLAND_DISPLAY XDG_RUNTIME_DIR FOXOS_LANG 2>/dev/null || true
  systemctl --user start foxos-mcp.service 2>/dev/null || true
fi
