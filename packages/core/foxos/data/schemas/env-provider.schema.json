{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://foxos.dev/schemas/env-provider/1",
 "title": "狐狸OS 环境提供者协议（foxos-env-provider/1）",
 "description": "provider.json 清单与 JSON-RPC 方法的参数 / 结果。",
 "type": "object",
 "$ref": "#/$defs/manifest",
 "$defs": {
  "capability": {"enum": ["create", "start", "stop", "exec", "shell", "snapshot", "restore", "clone", "export", "import", "delete", "mount", "limits", "stats", "logs", "agent", "list-online", "run", "desktop-attach"]},
  "platform": {"enum": ["linux", "windows", "macos"]},
  "manifest": {
   "type": "object",
   "required": ["protocol", "id", "platforms", "command"],
   "properties": {
    "protocol": {"const": "foxos-env-provider/1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "name": {"type": "string"},
    "version": {"type": "string"},
    "platforms": {"type": "array", "items": {"$ref": "#/$defs/platform"}},
    "guest_os": {"enum": ["linux", "windows", "macos", "any"]},
    "isolation": {"enum": ["light", "full"]},
    "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "启动提供者进程的命令；相对路径相对于清单所在目录"}
   }
  },
  "describe": {
   "type": "object",
   "required": ["id", "name", "protocol", "platforms", "guest_os", "isolation", "capabilities"],
   "properties": {
    "id": {"type": "string"}, "name": {"type": "string"}, "protocol": {"const": "foxos-env-provider/1"},
    "platforms": {"type": "array", "items": {"$ref": "#/$defs/platform"}},
    "guest_os": {"enum": ["linux", "windows", "macos", "any"]}, "isolation": {"enum": ["light", "full"]},
    "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
    "builtin": {"type": "boolean"}, "host_supported": {"type": "boolean"}
   }
  },
  "doctor": {
   "type": "object",
   "required": ["available", "checks", "actions"],
   "properties": {
    "available": {"type": "boolean"}, "reason": {"type": ["string", "null"]},
    "checks": {"type": "array", "items": {"type": "object", "required": ["id", "ok"], "properties": {"id": {"type": "string"}, "ok": {"type": ["boolean", "null"]}, "detail": {"type": "string"}}}},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/step"}}
   }
  },
  "step": {
   "type": "object",
   "description": "计划中的一步：恰好包含 argv / powershell / download / write / foxos 之一",
   "properties": {
    "id": {"type": "string"}, "label": {"type": "string"}, "why": {"type": "string"},
    "argv": {"type": "array", "items": {"type": "string"}},
    "powershell": {"type": "string"},
    "download": {"type": "string"}, "to": {"type": "string"}, "sha256": {"type": ["string", "null"]}, "convert": {"const": "tar.gz"},
    "write": {"type": "string"}, "content": {"type": "string"},
    "foxos": {"type": "array", "items": {"type": "string"}}, "workspace": {"type": ["string", "null"]},
    "elevate": {"type": "boolean"}, "confirm": {"type": "boolean"}, "manual": {"type": "boolean"},
    "registers": {"type": "string"}, "ok_codes": {"type": "array", "items": {"type": "integer"}}
   }
  }
 }
}
