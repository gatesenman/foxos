   "verb": "set",
   "summary": "Name",
   "source": "ui",
   "ui": {
    "path": "New project > New project > Name",
    "role": "textbox",
    "name": "Name",
    "region": "New project",
    "view": "New project"
   },
   "params": [
    {
     "name": "value",
     "type": "string",
     "description": "「Name」的新值",
     "required": true,
     "positional": true
    },
    {
     "name": "submit",
     "type": "boolean",
     "description": "设置后按 Enter 提交",
     "default": false
    }
   ],
   "effect": "把「Name」设为给定值（触发 input / change 事件）",
   "permission": "modify",
   "undoable": "可能（应用提供撤销，未逐项验证）",
   "binding": {
    "kind": "ui",
    "open": true,
    "steps": [
     {
      "click": {
       "name": "New project",
       "role": "button"
      }
     },
     {
      "wait": 400
     },
     {
      "set": {
       "name": "Name",
       "role": "textbox",
       "value": "{{value}}"
      }
     },
     {
      "press_if": "submit",
      "press": {
       "key": "Enter",
       "name": "Name",
       "role": "textbox"
      }
     }
    ]
   }
  },
