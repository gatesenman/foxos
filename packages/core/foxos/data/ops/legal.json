   "id": "currency.set",
   "resource": "currency",
   "verb": "set",
   "summary": "Currency",
   "source": "ui",
   "ui": {
    "path": "主界面 > dialog > Currency",
    "role": "combobox",
    "name": "Currency",
    "region": "dialog",
    "view": "主界面"
   },
   "params": [
    {
     "name": "value",
     "type": "string",
     "description": "「Currency」的新值",
     "required": true,
     "positional": true,
     "enum": [
      "USD",
      "CAD",
      "EUR",
      "GBP",
      "AUD",
      "NZD",
      "CHF",
      "JPY",
      "INR",
      "SGD",
      "HKD",
      "ZAR",
      "MXN",
      "BRL",
      "SEK",
      "NOK",
      "DKK",
      "AED"
     ]
    },
    {
     "name": "submit",
     "type": "boolean",
     "description": "设置后按 Enter 提交",
     "default": false
    }
   ],
   "effect": "把「Currency」设为给定值（触发 input / change 事件）",
   "permission": "modify",
   "undoable": "否（应用没有撤销入口）",
   "binding": {
    "kind": "ui",
    "open": true,
    "steps": [
     {
      "set": {
       "name": "Currency",
       "role": "combobox",
       "value": "{{value}}"
      }
     },
     {
      "press_if": "submit",
      "press": {
       "key": "Enter",
       "name": "Currency",
       "role": "combobox"
      }
     }
    ]
   }
  },
