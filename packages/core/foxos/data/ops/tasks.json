    "region": null,
    "view": "Search/"
   },
   "params": [
    {
     "name": "value",
     "type": "string",
     "description": "「Search tasks」的新值",
     "required": true,
     "positional": true
    },
    {
     "name": "submit",
     "type": "boolean",
     "description": "设置后按 Enter 提交",
     "default": false
    }
   ],
   "effect": "把「Search tasks」设为给定值（触发 input / change 事件）",
   "permission": "modify",
   "undoable": "否（应用没有撤销入口）",
   "binding": {
    "kind": "ui",
    "open": true,
    "steps": [
     {
      "click": {
       "name": "Search/",
       "role": "button"
      }
     },
     {
      "wait": 400
     },
     {
      "set": {
       "name": "Search tasks",
       "role": "textbox",
       "value": "{{value}}"
      }
     },
     {
      "press_if": "submit",
      "press": {
       "key": "Enter",
       "name": "Search tasks",
       "role": "textbox"
      }
     }
    ]
   }
  }
