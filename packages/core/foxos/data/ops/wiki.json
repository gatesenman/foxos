     "name": "value",
     "type": "string",
     "description": "「Getting started」的新值",
     "required": true,
     "positional": true
    },
    {
     "name": "submit",
     "type": "boolean",
     "description": "设置后按 Enter 提交",
     "default": false
    }
   ],
   "effect": "把「Getting started」设为给定值（触发 input / change 事件）",
   "permission": "modify",
   "undoable": "可能（应用提供撤销，未逐项验证）",
   "binding": {
    "kind": "ui",
    "open": true,
    "steps": [
     {
      "set": {
       "name": "Getting started",
       "role": "textbox",
       "value": "{{value}}"
      }
     },
     {
      "press_if": "submit",
