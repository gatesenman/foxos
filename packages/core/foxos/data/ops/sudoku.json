     "required": true,
     "positional": true,
     "enum": [
      "easy",
      "medium",
      "hard",
      "expert"
     ]
    },
    {
     "name": "submit",
     "type": "boolean",
     "description": "设置后按 Enter 提交",
     "default": false
    }
   ],
   "effect": "把「Next puzzle」设为给定值（触发 input / change 事件）",
   "permission": "modify",
   "undoable": "可能（应用提供撤销，未逐项验证）",
   "binding": {
    "kind": "ui",
    "open": true,
    "steps": [
     {
      "set": {
       "name": "Next puzzle",
       "role": "combobox",
       "value": "{{value}}"
      }
     },
     {
      "press_if": "submit",
      "press": {
       "key": "Enter",
       "name": "Next puzzle",
       "role": "combobox"
      }
     }
    ]
   }
  },
